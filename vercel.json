{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["iad1"],
  "functions": {
    "api/polish.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/v1/polish", "destination": "/api/polish" },
    {
      "source": "/download/:path*",
      "destination": "https://649ogrnzpi9dgfiw.public.blob.vercel-storage.com/:path*"
    }
  ]
}
